digraph request_flow {
    graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.30", ranksep="0.42"];
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.15,0.08", color="#263238"];
    edge [fontname="Helvetica", fontsize=9, color="#455a64"];

    dns [label="1. DNS / application\nClient → Mac 1: UDP 53\nA app.teamX.test = <MAC2_IP>", fillcolor="#e3f2fd"];
    tcp [label="2. TCP / transport\nClient ↔ Mac 2: SYN, SYN-ACK, ACK\ndestination port 443", fillcolor="#fff3e0"];
    tls [label="3. TLS / session + presentation\nClientHello SNI app.teamX.test\ncertificate → Finished", fillcolor="#f3e5f5"];
    edge_http [label="4. HTTP/2 / application\nHTTPS GET /api/status\nMac 2 decrypts at nginx", fillcolor="#e8eaf6"];
    backend [label="5. HTTP/1.1 / application\nMac 2 → Mac 3:3001 or Mac 4:3002\n200 + X-Backend: A|B", fillcolor="#e8f5e9"];
    response [label="6. Return path\nnginx sends 200 over TLS\nclient sees the edge hostname", fillcolor="#fce4ec"];

    dns -> tcp -> tls -> edge_http -> backend -> response;
}
